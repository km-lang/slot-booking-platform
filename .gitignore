node_modules/
server/.env
client/.env
server/prisma/dev.db
server/prisma/dev.db-journal
server/prisma/dev.db-shm
server/prisma/dev.db-wal
# Also catch accidental nested copies (e.g. server/prisma/prisma/dev.db from
# running a prisma command from the wrong working directory).
server/**/dev.db
server/**/dev.db-journal
server/**/dev.db-shm
server/**/dev.db-wal

# Built client bundle served by Express in production — regenerate with
# `npm run build` (client) and copy dist/* here, don't hand-edit or commit.
server/public/

# Timestamped rollback copies of server/public/ made before each deploy — local
# safety nets only, never committed (see README.deployment.md).
server/public_backup_*/
server/public_backups/

# Runtime data for the announcement/feedback popup (server/src/lib/announcementsStore.js).
# server/data/announcements.json (the authored content) IS committed — only the
# user-response log is excluded, since it's generated data, not source, and grows
# with every response the same way DB rows would.
server/data/announcement_responses.json