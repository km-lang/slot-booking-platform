// Parthsaarthi — Prisma Schema
//
// Local dev:  provider = "sqlite",  DATABASE_URL = "file:./dev.db"
// Production: provider = "postgresql", DATABASE_URL = "postgresql://..."
//             Also change Json? below — SQLite stores it as text; Postgres uses native jsonb.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  MENTOR
  AIGs
  SuperADMIN
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  ATTENDED
  NO_SHOW
}

// CV: today's 1:1 review slots (including the "cv_hr" focus variant — see
// Booking.focus). STOCK_PITCH is also 1:1 (a student's sector/stock pitch for
// interview prep) but has no focus sub-selector, unlike CV. GD/CASE are
// multi-participant, mentor-chosen capacity.
enum SlotType {
  CV
  GD
  CASE
  STOCK_PITCH
}

// Only meaningful on a CASE booking — self-selected by the student at booking
// time. Null for CV/GD bookings.
enum ParticipantRole {
  SOLVER
  SHADOW
}

enum WarnType {
  WARNING // 3 warnings auto-convert to 1 STRIKE via bookingController
  STRIKE  // directly feeds ban evaluation
}

// Structural categorization of an AIG row — Disha is a Committee, not an AIG,
// despite sharing the same table/role/route plumbing. Display/grouping only;
// does not affect RBAC (role "AIGs", /admin/:aigSlug, requireAigScope all key
// off the row's slug/id, never this field).
enum OrgCategory {
  COMMITTEE
  CLUB
  AIG
}

// Distinguishes alumni mentors from current PGP2 students. PGP2_STUDENT
// mentors can still have a real aigId (e.g. Cracktank) — PGP2_STUDENT_NO_AIG
// specifically marks the "PGP 2 Mentors" independent bucket, kept as its own
// display group distinct from the older "Non Disha Mentors" (aigId null,
// mentorType PGP2_STUDENT) population.
enum MentorType {
  ALUMNI
  PGP2_STUDENT
  PGP2_STUDENT_NO_AIG
}

// ─── Access Control ───────────────────────────────────────────────────────────

// The sole gate to the platform. No email outside this table can log in,
// regardless of a valid Google credential.
model AccessWhitelist {
  id        String   @id @default(cuid())
  email     String   @unique
  role      Role
  aigId     String?  // scopes AIGs-tier rows to one AIG
  cohortId  String?  // optionally scopes a MENTOR to a specific cohort at invite time
  addedBy   String   // email of the SuperADMIN who added this row
  createdAt DateTime @default(now())

  aig    AIG?    @relation(fields: [aigId], references: [id])
  cohort Cohort? @relation(fields: [cohortId], references: [id])
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  role      Role
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile StudentProfile?
  mentorProfile  MentorProfile?
  bookings       Booking[]
  warnings       StudentWarning[]
  bans           Ban[]
  auditEvents    AuditEvent[]
  slotWaitlist   SlotWaitlist[]
}

model StudentProfile {
  id            String  @id @default(cuid())
  userId        String  @unique
  pgpId         String  @unique // e.g. "25110"
  cohortId      String?
  sigfiCohortId String? // independent SIGFi-program cohort slot, alongside cohortId (e.g. Disha) — see server/src/lib/cohortMembership.js

  user        User    @relation(fields: [userId], references: [id])
  cohort      Cohort? @relation("StudentPrimaryCohort", fields: [cohortId], references: [id])
  sigfiCohort Cohort? @relation("StudentSigfiCohort", fields: [sigfiCohortId], references: [id])
}

model MentorProfile {
  id         String     @id @default(cuid())
  userId     String     @unique
  pgpId      String     @unique // e.g. "PGP41259" / "ABM22011" — derived from email local-part
  slug       String     @unique // e.g. "evelyn-vance" — server-generated at profile creation
  firm       String
  domain     String
  phone      String?    // optional mobile number, mentor-editable — used for the student-facing Call/WhatsApp actions
  aigId      String?    // null = no org affiliation (e.g. a PGP2-student mentor)
  cohortId   String?
  mentorType MentorType @default(ALUMNI)

  user            User            @relation(fields: [userId], references: [id])
  aig             AIG?            @relation(fields: [aigId], references: [id])
  cohort          Cohort?         @relation(fields: [cohortId], references: [id])
  bookingReleases BookingRelease[]
  slots           Slot[]
  bookings        Booking[]
}

// ─── Organisation ─────────────────────────────────────────────────────────────

model AIG {
  id       String      @id @default(cuid())
  slug     String      @unique // e.g. "disha" — used in /admin/:aigSlug routes
  name     String              // e.g. "Team Disha" — display name fetched by AigAdminDashboard
  type     String              // e.g. "Core Preparation" | "Domain AIG" — free-text display label
  category OrgCategory @default(AIG) // structural bucket: Disha is COMMITTEE, the rest are AIG

  cohorts          Cohort[]
  mentorProfiles   MentorProfile[]
  whitelistEntries AccessWhitelist[]
}

model Cohort {
  id     String @id @default(cuid())
  label  String // e.g. "Q4"
  aigId  String

  aig                  AIG               @relation(fields: [aigId], references: [id])
  studentProfiles      StudentProfile[]  @relation("StudentPrimaryCohort")
  sigfiStudentProfiles StudentProfile[]  @relation("StudentSigfiCohort")
  mentorProfiles       MentorProfile[]
  whitelistEntries     AccessWhitelist[]
}

// ─── Slots & Bookings ─────────────────────────────────────────────────────────

model BookingRelease {
  id              String   @id @default(cuid())
  mentorProfileId String
  startTime       DateTime
  endTime         DateTime
  slotDuration    Int      // minutes per slot
  venue           String
  cohortOnly      Boolean  @default(false)
  meetingLink     String?  // default Google Meet (or other) link applied to every slot created in this batch
  slotType        SlotType @default(CV)
  capacity        Int      @default(1) // participants per slot; CV/STOCK_PITCH always 1, GD/CASE mentor-chosen (GD >= 2, CASE >= 1)
  caseDescription String?  // CASE slots only — the case being reviewed, shown to students before they book (~200 words)
  createdAt       DateTime @default(now())

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id])
  slots         Slot[]
}

model Slot {
  id              String   @id @default(cuid())
  releaseId       String
  mentorProfileId String
  startTime       DateTime
  endTime         DateTime
  venue           String
  version         Int      @default(0)
  delayMinutes    Int      @default(0)
  meetingLink     String?  // editable independently per-slot, e.g. added after the batch was created
  icsSequence     Int      @default(0) // RFC 5545 SEQUENCE for this slot's calendar event — bumped on reschedule
  published       Boolean  @default(true) // false = draft, created but not yet visible/bookable by students
  retired         Boolean  @default(false) // true = a dead slot with cancelled-booking history, kept (never
                                            // hard-deleted, never time-edited) so that booking's history stays
                                            // accurate; excluded from the no-overlap check below so its time
                                            // range is free again for a brand new slot. See deleteSlot.

  release       BookingRelease @relation(fields: [releaseId], references: [id])
  mentorProfile MentorProfile  @relation(fields: [mentorProfileId], references: [id])
  capacity      SlotCapacity?
  bookings      Booking[]
  waitlist      SlotWaitlist[]

  // A mentor may not have two non-retired slots with overlapping [startTime, endTime)
  // ranges — enforced as a partial GiST exclusion constraint (slot_no_overlap_per_mentor,
  // WHERE retired = false) in the migration SQL, since Prisma's schema DSL can't express
  // range-exclusion constraints.
}

// One-shot notification queue: when a full slot frees up, every waitlisted student
// is emailed once and their row is deleted — never auto-booked on their behalf.
model SlotWaitlist {
  id            String   @id @default(cuid())
  slotId        String
  studentUserId String
  createdAt     DateTime @default(now())

  slot    Slot @relation(fields: [slotId], references: [id])
  student User @relation(fields: [studentUserId], references: [id])

  @@unique([slotId, studentUserId])
}

// Separate table so max capacity is configurable per slot without touching Slot itself
model SlotCapacity {
  slotId        String  @id
  max           Int     @default(1)
  current       Int     @default(0)
  solverClaimed Boolean @default(false) // CASE slots only — atomically flipped alongside
                                         // current when a student claims the Solver seat,
                                         // same one-UPDATE pattern as the capacity claim
                                         // itself. Always false for CV/GD slots.

  slot Slot @relation(fields: [slotId], references: [id])
}

model Booking {
  id              String        @id @default(cuid())
  slotId          String
  studentUserId   String
  mentorProfileId String        // denormalized from Slot at creation — backs the one-active-booking-per-mentor-per-type constraint below
  slotType        SlotType      // denormalized from Slot.release at creation — same reason as mentorProfileId, backs the same constraint
  focus           String?       // "overall" | "workex" | "por" | "cv_hr" — CV slots only, null for GD/CASE/STOCK_PITCH
  role            ParticipantRole? // CASE slots only — SOLVER or SHADOW, self-selected at booking time
  idempotencyKey  String        @unique // client-generated UUID; replays return existing booking
  status          BookingStatus @default(CONFIRMED)
  allocatedBy     String?       // mentor's email, if this booking was directly allocated rather than self-booked
  cancelledBy     Role?         // who cancelled it — STUDENT (legacy, self-cancel is now disabled) or MENTOR (unassign/delete)
  cancelledAt     DateTime?
  createdAt       DateTime      @default(now())

  slot          Slot          @relation(fields: [slotId], references: [id])
  student       User          @relation(fields: [studentUserId], references: [id])
  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id])

  // A student may hold at most one CONFIRMED booking per (mentor, slotType, focus) at
  // a time — e.g. a CASE booking and a CV-HR booking with the same mentor can coexist,
  // but not two CASE bookings, and not two CV bookings of the same focus. Enforced as a
  // partial unique index on (studentUserId, mentorProfileId, slotType, COALESCE(focus, ''))
  // WHERE status = 'CONFIRMED' in the migration SQL, since Prisma's schema DSL can't
  // express a conditional/expression unique constraint directly.
}

// ─── Penalties & Bans ─────────────────────────────────────────────────────────

model StudentWarning {
  id        String   @id @default(cuid())
  userId    String
  bookingId String?  // the booking that triggered this warning/strike
  type      WarnType @default(WARNING)
  reason    String
  issuedBy  String?  // acting mentor's email — set when manually applied, or by markAttendance's NO_SHOW path
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Ban {
  id       String    @id @default(cuid())
  userId   String
  reason   String
  startsAt DateTime  @default(now())
  endsAt   DateTime? // null = permanent
  liftedAt DateTime? // set when a SuperADMIN manually lifts the ban
  liftedBy String?   // email of the admin who lifted it

  user User @relation(fields: [userId], references: [id])
}

// Seeded tiers that the booking controller reads at runtime (no hardcoded thresholds)
model BanPolicyTier {
  id               Int    @id @default(autoincrement())
  strikeThreshold  Int    @unique // minimum strike count to trigger this tier
  banDurationHours Int?   // null = permanent ban
  description      String
}

// ─── Observability ────────────────────────────────────────────────────────────

model AuditEvent {
  id        String   @id @default(cuid())
  userId    String?  // null for system-generated events
  action    String   // e.g. "BOOKING_CREATED", "BAN_APPLIED", "SLOT_RELEASED"
  entity    String   // e.g. "Booking", "Ban", "Slot"
  entityId  String?
  meta      String?  // JSON string (use JSON.parse/stringify in controllers)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

// ─── Global Config ────────────────────────────────────────────────────────────

// Key/value store for global settings: cv_freeze_deadline, booking_open, etc.
// Read by AigAdminDashboard (countdown) and potentially booking controller (gate).
model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
